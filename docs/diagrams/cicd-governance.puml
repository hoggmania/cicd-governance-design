@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title CI/CD Governance - In-toto / DSSE with Vault or OpenBao
Person(security, "Security Manager", "Authors scoped security policies")
Person(manager, "Application Manager", "Owns program delivery and requests bypasses")
Person(lead, "Project Lead", "Owns repository metadata and evidence integration")
Person(approver, "Security Reviewer", "Approves or denies scoped bypass requests")
System_Boundary(governance, "Self-hosted Gate Governance Service") {
Container(pap, "Governance Management", "Web UI + Management API", "Hierarchy, bypass workflow and read-only policy status; no direct policy edits")
Container(registry, "Governance Registry", "Transactional database", "Ownership, dynamic exceptions and release activation status")
Container(pdp, "PDP - Gate Decision Service", "Decision API + CEL Runtime", "Evaluate authenticated requests using eligible verified policy snapshots")
Container(loader, "PDP Policy Loader", "Poll + In-toto / DSSE verifier", "Verify provenance and release authority; validate CEL; atomically activate")
Container(evidence, "Evidence and Attestation Service", "In-toto / DSSE verifier + Storage", "Verify issuer, predicate, subject and freshness; retain immutable claims")
Container(audit, "Decision and Audit Ledger", "Append-only storage", "Record policy changes, evidence references and gate decisions")
Container(notify, "Notification Outbox and Worker", "Durable queue + Email adapter", "Route action emails to authorized parties; retry and audit delivery")
}
System_Boundary(authoring, "PAP - Git Authoring and Release") {
Container(gitpolicy, "Policy Git Repository", "CEL + Metadata + Tests", "Security Manager authoring and independent protected PR approval")
Container(release, "Policy Release Pipeline", "Trusted post-merge CI", "Test, package, sign and publish immutable archives")
}
System_Ext(storage, "S3 or Artifactory", "CEL archives and DSSE provenance / release attestations")
System_Ext(signer, "Vault / OpenBao Transit", "Separate non-exportable producer keys; scoped signing and rotation")
System_Ext(trust, "Independent Trust Configuration", "Public key versions, issuer authority, revocation and freshness")
System_Ext(idp, "Enterprise Identity", "Human SSO and workload identity")
System_Ext(pep, "CI/CD - Policy Enforcement Points", "Protected pipeline jobs block merge, promotion and deployment")
System_Ext(producers, "Evidence Producers", "Tests, scanners, artifact attestations and change systems")
System_Ext(mail, "Approved Email Relay", "Delivers action notifications to authorized interested parties")
Rel(security, gitpolicy, "Authors CEL and submits PR")
Rel(approver, gitpolicy, "Independent PR review; separate proposed permission")
Rel(gitpolicy, release, "Approved merged revision")
Rel(release, signer, "Signs DSSE provenance and release PAE")
Rel(pap, signer, "Signs bypass-review statements")
Rel(pdp, signer, "Signs gate-decision statements")
Rel(pep, signer, "Signs enforcement receipts")
Rel(trust, loader, "Supplies public verification trust")
Rel(trust, evidence, "Supplies issuer / predicate authority")
Rel(trust, pep, "Supplies PDP verification trust")
Rel(release, storage, "Publishes immutable signed release")
Rel(loader, storage, "Periodically downloads archive and envelope")
Rel(loader, pdp, "Activates only verified eligible CEL snapshot")
Rel(release, pap, "Durable release events for audit and email")
Rel(loader, pap, "Verification and activation events")
Rel(manager, pap, "Requests bypass with explicit validity")
Rel(lead, pap, "Maintains metadata; views governance")
Rel(approver, pap, "Approves or denies bypass")
Rel(pap, registry, "Manages ownership, bypasses and release status")
Rel(pap, evidence, "Stores signed bypass-review attestations")
Rel(pap, audit, "Records control-plane changes")
Rel(pap, notify, "Atomically queues action events with audit")
Rel(pdp, notify, "Queues decision and bypass-use events")
Rel(notify, mail, "Sends authorized notifications", "Authenticated email transport")
Rel(notify, audit, "Records delivery attempts and outcomes")
Rel(pdp, registry, "Reads current authenticated exceptions")
Rel(pdp, evidence, "Retrieves verified facts and approvals")
Rel(pdp, audit, "Persists decision before returning permit")
Rel(pep, pdp, "Requests and verifies DSSE decision", "HTTPS + workload identity")
Rel(pep, evidence, "Stores signed enforcement receipts")
Rel(producers, evidence, "Supplies in-toto evidence attestations", "Authenticated ingestion")
Rel(idp, pap, "Authenticates people")
Rel(idp, pdp, "Validates workload identity")
SHOW_LEGEND()
@enduml
